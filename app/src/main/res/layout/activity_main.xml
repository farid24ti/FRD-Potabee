<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/black"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MY SNACK"
        android:textColor="@color/potabee_red_soft"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PROJECT"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.04"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Potabee Spicy BBQ"
        android:textColor="@color/text_secondary"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="32dp" />

    <ImageView
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:src="@drawable/potabee"
        android:contentDescription="Potabee Spicy BBQ"
        android:scaleType="centerInside"
        android:layout_marginBottom="34dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Discover the taste."
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Explore my snack project"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="26dp" />

    <Button
        android:id="@+id/btnMyProject"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MY PROJECT"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_button_red"
        android:textAllCaps="false"
        android:elevation="6dp" />

</LinearLayout>
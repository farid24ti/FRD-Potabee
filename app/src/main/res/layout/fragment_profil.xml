<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/siksp_background">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        app:title="Profil Developer"
        app:titleTextColor="@color/siksp_text_dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER BIRU + AVATAR -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="225dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="225dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/siksp_wave_header"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="16dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:src="@drawable/foto_developer"
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto Developer"
                        app:shapeAppearanceOverlay="@style/SIKSPLogoShape" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/dev_name"
                        android:textColor="@color/siksp_white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/lexend" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/dev_role"
                        android:textColor="@color/siksp_white"
                        android:textSize="11sp"
                        android:fontFamily="@font/lexend" />

                </LinearLayout>

            </FrameLayout>

            <!-- ISI PROFIL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="6dp"
                android:paddingBottom="28dp">

                <!-- TENTANG SAYA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/siksp_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/SIKSPCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tentang Saya" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/dev_about"
                        android:textColor="@color/siksp_text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="@font/lexend" />

                </LinearLayout>

                <!-- DATA DIRI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/siksp_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/SIKSPCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Data Diri" />

                    <TextView
                        style="@style/SIKSPLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nama Lengkap" />
                    <TextView
                        style="@style/SIKSPValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dev_fullname" />

                    <TextView
                        style="@style/SIKSPLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NIM" />
                    <TextView
                        style="@style/SIKSPValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dev_nim" />

                    <TextView
                        style="@style/SIKSPLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kelas" />
                    <TextView
                        style="@style/SIKSPValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dev_class" />

                    <TextView
                        style="@style/SIKSPLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kampus" />
                    <TextView
                        style="@style/SIKSPValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="0dp"
                        android:text="@string/dev_campus" />

                </LinearLayout>

                <!-- SOSIAL MEDIA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/siksp_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/SIKSPCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sosial Media" />

                    <TextView
                        style="@style/SIKSPLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Instagram" />
                    <TextView
                        style="@style/SIKSPValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dev_instagram" />

                    <TextView
                        style="@style/SIKSPLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="GitHub" />
                    <TextView
                        style="@style/SIKSPValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dev_github" />

                    <TextView
                        style="@style/SIKSPLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Email" />
                    <TextView
                        style="@style/SIKSPValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="0dp"
                        android:text="@string/dev_email" />

                </LinearLayout>

                <!-- HOBI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/siksp_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/SIKSPCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hobi" />

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:text="@string/dev_hobby_1"
                            android:textColor="@color/siksp_primary"
                            android:fontFamily="@font/lexend"
                            app:chipBackgroundColor="@color/siksp_light_blue"
                            app:chipStrokeWidth="0dp" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:text="@string/dev_hobby_2"
                            android:textColor="@color/siksp_primary"
                            android:fontFamily="@font/lexend"
                            app:chipBackgroundColor="@color/siksp_light_blue"
                            app:chipStrokeWidth="0dp" />

                        <com.google.android.material.chip.Chip
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:text="@string/dev_hobby_3"
                            android:textColor="@color/siksp_primary"
                            android:fontFamily="@font/lexend"
                            app:chipBackgroundColor="@color/siksp_light_blue"
                            app:chipStrokeWidth="0dp" />

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>

                <!-- Keahlian -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/siksp_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/SIKSPCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Keahlian" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/dev_strength"
                        android:textColor="@color/siksp_text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="@font/lexend" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
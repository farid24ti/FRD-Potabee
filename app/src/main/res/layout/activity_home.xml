<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER BIRU -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="225dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="225dp"
                android:scaleType="fitXY"
                android:src="@drawable/siksp_wave_header"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="110dp"
                android:paddingTop="48dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Halo,"
                    android:textColor="@color/siksp_white"
                    android:textSize="14sp"
                    android:fontFamily="@font/lexend" />

                <TextView
                    android:id="@+id/txtNama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pengguna"
                    android:textColor="@color/siksp_white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/lexend" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Selamat datang di SI-KSP Mobile"
                    android:textColor="@color/siksp_white"
                    android:textSize="12sp"
                    android:fontFamily="@font/lexend" />

            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="24dp"
                android:padding="6dp"
                android:src="@drawable/logo_siksp"
                android:scaleType="centerInside"
                android:contentDescription="@string/siksp_app_name"
                app:shapeAppearanceOverlay="@style/SIKSPLogoShape" />

        </FrameLayout>

        <!-- MENU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="26dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menu Utama"
                android:textColor="@color/siksp_text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/lexend" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pilih menu untuk melanjutkan"
                android:textColor="@color/siksp_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/lexend" />

            <Button
                android:id="@+id/btnProfil"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/siksp_button_primary"
                android:backgroundTint="@null"
                android:text="Profil Developer"
                android:textAllCaps="false"
                android:textColor="@color/siksp_white"
                android:textSize="15sp"
                android:fontFamily="@font/lexend" />

            <Button
                android:id="@+id/btnInfo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/siksp_button_outline"
                android:backgroundTint="@null"
                android:text="Informasi Koperasi"
                android:textAllCaps="false"
                android:textColor="@color/siksp_primary"
                android:textSize="14sp"
                android:fontFamily="@font/lexend" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="@color/siksp_white"
                android:textSize="14sp"
                android:fontFamily="@font/lexend"
                app:backgroundTint="@color/siksp_danger"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
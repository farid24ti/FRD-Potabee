<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Login"
        app:titleTextColor="@color/siksp_text_dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BLUE HEADER -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="225dp">

                <!-- WAVE BACKGROUND -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="225dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/siksp_wave_header"
                    android:contentDescription="@null" />

                <!-- HEADER CONTENT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="16dp">

                    <!-- LOGO -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:padding="7dp"
                        android:src="@drawable/logo_siksp"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/siksp_app_name"
                        app:shapeAppearanceOverlay="@style/SIKSPLogoShape" />

                    <!-- APP NAME -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="SI-KSP Mobile"
                        android:textColor="@color/siksp_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/lexend" />

                    <!-- TAGLINE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mudah, Aman, Terpercaya"
                        android:textColor="@color/siksp_white"
                        android:textSize="10sp"
                        android:fontFamily="@font/lexend" />

                </LinearLayout>

            </FrameLayout>

            <!-- LOGIN CONTENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="26dp"
                android:paddingBottom="30dp">

                <!-- TITLE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selamat Datang"
                    android:textColor="@color/siksp_text_dark"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/lexend" />

                <!-- DESCRIPTION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Masuk untuk melanjutkan ke SI-KSP Mobile"
                    android:textColor="@color/siksp_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/lexend" />

                <!-- USERNAME -->
                <EditText
                    android:id="@+id/inputUsername"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/siksp_input"
                    android:hint="Username"
                    android:textColor="@color/siksp_text_dark"
                    android:textColorHint="@color/siksp_text_secondary"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/lexend" />

                <!-- PASSWORD -->
                <EditText
                    android:id="@+id/inputPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/siksp_input"
                    android:hint="Password"
                    android:textColor="@color/siksp_text_dark"
                    android:textColorHint="@color/siksp_text_secondary"
                    android:textSize="14sp"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/lexend" />

                <!-- LOGIN BUTTON -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/siksp_button_primary"
                    android:backgroundTint="@null"
                    android:text="LOGIN"
                    android:textAllCaps="false"
                    android:textColor="@color/siksp_white"
                    android:textSize="15sp"
                    android:fontFamily="@font/lexend" />

                <!-- INFORMATION BUTTON -->
                <Button
                    android:id="@+id/btnInfo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/siksp_button_outline"
                    android:backgroundTint="@null"
                    android:text="Informasi Koperasi"
                    android:textAllCaps="false"
                    android:textColor="@color/siksp_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/lexend" />

                <!-- REGISTER -->
                <TextView
                    android:id="@+id/txtRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Belum punya akun?  Daftar sekarang"
                    android:textColor="@color/siksp_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/lexend"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Register"
        app:titleTextColor="@color/siksp_text_dark" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BLUE HEADER -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp">

                <!-- WAVE -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/siksp_wave_header"
                    android:contentDescription="@null" />

                <!-- HEADER CONTENT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="14dp">

                    <!-- LOGO -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:padding="6dp"
                        android:src="@drawable/logo_siksp"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/siksp_app_name"
                        app:shapeAppearanceOverlay="@style/SIKSPLogoShape" />

                    <!-- APP NAME -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="SI-KSP Mobile"
                        android:textColor="@color/siksp_white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/lexend" />

                    <!-- TAGLINE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Mudah, Aman, Terpercaya"
                        android:textColor="@color/siksp_white"
                        android:textSize="9sp"
                        android:fontFamily="@font/lexend" />

                </LinearLayout>

            </FrameLayout>

            <!-- REGISTER CONTENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="22dp"
                android:paddingBottom="30dp">

                <!-- TITLE -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buat Akun"
                    android:textColor="@color/siksp_text_dark"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/lexend" />

                <!-- DESCRIPTION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Daftarkan akun untuk menggunakan SI-KSP Mobile"
                    android:textColor="@color/siksp_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/lexend" />

                <!-- NAMA LENGKAP -->
                <EditText
                    android:id="@+id/inputNama"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/siksp_input"
                    android:hint="Nama Lengkap"
                    android:textColor="@color/siksp_text_dark"
                    android:textColorHint="@color/siksp_text_secondary"
                    android:textSize="13sp"
                    android:inputType="textPersonName"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/lexend" />

                <!-- USERNAME -->
                <EditText
                    android:id="@+id/inputUsername"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/siksp_input"
                    android:hint="Username"
                    android:textColor="@color/siksp_text_dark"
                    android:textColorHint="@color/siksp_text_secondary"
                    android:textSize="13sp"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/lexend" />

                <!-- NOMOR HP -->
                <EditText
                    android:id="@+id/inputNoHp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/siksp_input"
                    android:hint="Nomor HP"
                    android:textColor="@color/siksp_text_dark"
                    android:textColorHint="@color/siksp_text_secondary"
                    android:textSize="13sp"
                    android:inputType="phone"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/lexend" />

                <!-- PASSWORD -->
                <EditText
                    android:id="@+id/inputPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/siksp_input"
                    android:hint="Password"
                    android:textColor="@color/siksp_text_dark"
                    android:textColorHint="@color/siksp_text_secondary"
                    android:textSize="13sp"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/lexend" />

                <!-- KONFIRMASI PASSWORD -->
                <EditText
                    android:id="@+id/inputKonfirmasiPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/siksp_input"
                    android:hint="Konfirmasi Password"
                    android:textColor="@color/siksp_text_dark"
                    android:textColorHint="@color/siksp_text_secondary"
                    android:textSize="13sp"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:fontFamily="@font/lexend" />

                <!-- DAFTAR -->
                <Button
                    android:id="@+id/btnDaftar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/siksp_button_primary"
                    android:backgroundTint="@null"
                    android:text="DAFTAR"
                    android:textAllCaps="false"
                    android:textColor="@color/siksp_white"
                    android:textSize="15sp"
                    android:fontFamily="@font/lexend" />

                <!-- LOGIN -->
                <TextView
                    android:id="@+id/txtLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Sudah punya akun?  Login"
                    android:textColor="@color/siksp_primary"
                    android:textSize="13sp"
                    android:fontFamily="@font/lexend"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
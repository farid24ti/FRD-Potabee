<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Register With Gmail"
        app:titleTextColor="@color/siksp_text_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masukkan email Gmail Anda"
            android:textColor="@color/siksp_text_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/lexend" />

        <EditText
            android:id="@+id/inputEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/siksp_input"
            android:hint="Email"
            android:textColor="@color/siksp_text_dark"
            android:textColorHint="@color/siksp_text_secondary"
            android:textSize="14sp"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:fontFamily="@font/lexend" />

        <Button
            android:id="@+id/btnLanjut"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/siksp_button_primary"
            android:backgroundTint="@null"
            android:text="Lanjut"
            android:textAllCaps="false"
            android:textColor="@color/siksp_white"
            android:textSize="15sp"
            android:fontFamily="@font/lexend" />

    </LinearLayout>
</LinearLayout>